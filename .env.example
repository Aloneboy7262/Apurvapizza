# ==============================================================================
# Apurva Pizza Hub - Unified Environment Configuration
# ==============================================================================

# Backend Server & Security
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb://localhost:27017/apurva_pizza_hub
JWT_SECRET=replace_with_a_secure_minimum_32_character_cryptographic_secret
JWT_EXPIRES_IN=7d
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# URLs for CORS and Redirection
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:3001
CLIENT_URL=http://localhost:5173

# Staff Credentials (Used for Initial Seeding / Staff Authentication)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeWithStrongPassword2026!
ADMIN_PHONE=9876543210
ADMIN_NAME=System Administrator

KITCHEN_USERNAME=chef_kitchen
KITCHEN_PASSWORD=ChangeMeWithStrongPassword2026!
KITCHEN_PHONE=9876543211
KITCHEN_NAME=Kitchen Display Chef

DRIVER_USERNAME=rider_deoria
DRIVER_PASSWORD=ChangeMeWithStrongPassword2026!
DRIVER_PHONE=9876543212
DRIVER_NAME=Rider Ramesh Kumar

# Telecom SMS Gateways for Customer OTP (Fast2SMS or Twilio)
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Customer Storefront (Vite) - UI routes via reverse proxy /api
VITE_API_URL=/api
VITE_SOCKET_URL=
VITE_SUPPORT_PHONE=919876543210
VITE_GOOGLE_MAPS_API_KEY=
VITE_MAPBOX_ACCESS_TOKEN=

# Admin & Kitchen Portal (Vite) - UI routes via reverse proxy /api
VITE_ADMIN_API_URL=/api
VITE_ADMIN_SOCKET_URL=
VITE_CUSTOMER_URL=http://localhost:5173
