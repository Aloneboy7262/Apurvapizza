# ==============================================================================
# Apurva Pizza Hub - Production Deployment Configuration Template
# Copy this file to .env before running docker compose up or deploying.
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=5000

# Database (Internal Docker network hostname: mongodb)
MONGODB_URI=mongodb://mongodb:27017/apurva_pizza_hub

# JWT Secret - MUST be at least 32 characters long
# Generate securely: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_minimum_32_character_cryptographic_secret
JWT_EXPIRES_IN=7d

# Allowed Origins (Comma-separated list of your production domains)
ALLOWED_ORIGINS=https://pizza.yourdomain.com,https://admin.yourdomain.com
FRONTEND_URL=https://pizza.yourdomain.com
ADMIN_URL=https://admin.yourdomain.com
CLIENT_URL=https://pizza.yourdomain.com

# Ports for Reverse-Proxied Frontend Containers
PORT_FRONTEND=80
PORT_ADMIN=3001

# Production Staff Credentials (Set strong, unique passwords for production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SetAStrongProductionPassword123!
ADMIN_PHONE=9876543210
ADMIN_NAME=System Administrator

KITCHEN_USERNAME=chef_kitchen
KITCHEN_PASSWORD=SetAStrongProductionPassword123!
KITCHEN_PHONE=9876543211
KITCHEN_NAME=Kitchen Display Chef

DRIVER_USERNAME=rider_deoria
DRIVER_PASSWORD=SetAStrongProductionPassword123!
DRIVER_PHONE=9876543212
DRIVER_NAME=Fleet Rider

# Live SMS Gateway for 6-Digit OTP Delivery
# Option A: Fast2SMS (Indian Gateway)
FAST2SMS_API_KEY=your_fast2sms_api_key_here
# Option B: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Frontend Environment Variables (Injected during build or runtime)
# Leave VITE_API_URL as /api so the browser routes requests through the Nginx reverse proxy
VITE_API_URL=/api
VITE_SOCKET_URL=
VITE_SUPPORT_PHONE=919876543210
VITE_CUSTOMER_URL=https://pizza.yourdomain.com
VITE_GOOGLE_MAPS_API_KEY=
VITE_MAPBOX_ACCESS_TOKEN=
